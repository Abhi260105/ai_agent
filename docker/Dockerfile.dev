# Development Dockerfile with hot-reload and debugging tools
FROM python:3.11-slim

# Set working directory
WORKDIR /app

# Install system dependencies including dev tools
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
    curl \
    git \
    vim \
    gcc \
    g++ \
    make \
    postgresql-client \
    redis-tools \
    && rm -rf /var/lib/apt/lists/*

# Install Node.js for frontend development
RUN curl -fsSL https://deb.nodesource.com/setup_18.x | bash - && \
    apt-get install -y nodejs && \
    npm install -g nodemon

# Copy requirements
COPY requirements.txt requirements-dev.txt* ./

# Install Python dependencies (including dev dependencies)
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt && \
    if [ -f requirements-dev.txt ]; then pip install --no-cache-dir -r requirements-dev.txt; fi

# Install debugging tools
RUN pip install --no-cache-dir \
    debugpy \
    ipython \
    ipdb \
    pytest \
    pytest-cov \
    black \
    flake8 \
    pylint \
    mypy

# Copy package files and install Node dependencies
COPY package*.json ./
RUN npm install

# Copy application code
COPY . .

# Set environment variables for development
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    NODE_ENV=development \
    FLASK_ENV=development \
    DEBUG=1

# Expose application port
EXPOSE 8080

# Expose debugger port
EXPOSE 5678

# Expose frontend dev server port (if applicable)
EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1

# Development command with hot-reload
# Override this in docker-compose.yml for specific services
CMD ["python", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8080", "--reload"]